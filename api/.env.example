# Copy to .env for local runs. Never commit .env (it is git-ignored).
PORT=8080
APP_ENV=local
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
STORE_BACKEND=memory
TABLE_NAME=cakeshop-dev
# AWS (Sprint 2+): SSO profile for the cakeshop-dev account, Mumbai region
AWS_PROFILE=cakeshop-dev
AWS_REGION=ap-south-1
# Sprint 6 (AI assistant). Leave empty if using Bedrock with IAM.
# ANTHROPIC_API_KEY=
