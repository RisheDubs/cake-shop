{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API: run & debug (localhost:8080)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/api/cmd/server",
      "cwd": "${workspaceFolder}/api",
      "envFile": "${workspaceFolder}/api/.env"
    },
    {
      "name": "API: debug current test",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}"
    }
  ]
}
